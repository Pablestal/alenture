# Copy to .env (git-ignored) and fill in. Not .env.local: Vite loads and merges
# both, so a variable put in the wrong one works, and the next person to go
# looking finds the file it should have been in and concludes it was never set.

# The two basemaps the layers panel switches between. OpenFreeMap serves both
# and needs no API key. Liberty is the dark default the app was designed on;
# Positron is the light one.
#
# Both are required and neither has a default, for the same reason as the
# geocoding pair below: they can disagree. Point one at a self-hosted tileserver
# and forget the other, and half the switch quietly goes back to the public
# instance — which looks like nothing at all, because both halves render a map.
#
# There is deliberately no satellite option. Every key-free imagery source is a
# raster TILE TEMPLATE, not a style document, so it could not be a URL in this
# file the way these two are — it would need a style JSON hand-built in the app
# around it. Its absence is a decision, not an oversight: satellite imagery does
# not help you decide which square you stood in, which is what this map is for.
VITE_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_STYLE_LIGHT_URL=https://tiles.openfreemap.org/styles/positron

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# Root URL only — no path. supabase-js appends /auth/v1, /rest/v1 and friends
# itself; leaving /rest/v1 on the end sends sign-in requests to PostgREST, which
# answers PGRST125.
VITE_SUPABASE_URL=

# Supabase anon (publishable) key. Public by design — it ships in the bundle and
# RLS is what protects the data. Keep it out of the repo all the same.
VITE_SUPABASE_ANON_KEY=

# Geocoding endpoints. Photon, serving OpenStreetMap data under ODbL. The public
# instance below needs no API key and asks for no more than one request per
# second, which the repository enforces across both endpoints together. Point
# these at a self-hosted Photon to lift that.
#
# Both are required and neither has a default, because they can disagree: set
# one to your own instance and forget the other, and half the feature quietly
# keeps using the public one. The symptom is a pin whose city is never detected,
# which looks exactly like the geocoder having nothing to say about that point.
VITE_GEOCODING_API_URL=https://photon.komoot.io/api

# Reverse, used to name a pin once it has been placed. A separate variable
# rather than one derived from the URL above: /api and /reverse being siblings
# is a fact about Photon's current URL layout, not a contract, and a self-hosted
# instance may route them anywhere.
VITE_GEOCODING_REVERSE_URL=https://photon.komoot.io/reverse
